-- ============================================================
-- 店面展示清单 —— 复制本文件为 display.sql 后按实际库表修改
-- 输出：Output-NZ/display.xlsx（看板读这个文件生成「店面」下拉）
-- ============================================================
--
-- 必须包含的列（列名可不同，程序会模糊匹配）：
--   产品编码：ProductCode / Sku / Code
--   店面名称：DisplayWarehouse / Store / Warehouse / WarehouseName
--
-- 可选列：ProductName, Family / ProductFamily
--
-- 注意：
-- 1. 文件名必须是 display.sql（或 store_display.sql），才会写到 display.xlsx
-- 2. display.minimal.sql 不会写入 display.xlsx，看板读不到
-- 3. 正常应有成百上千行；若只有 1 行，店面下拉会为空
--
-- 示例（请替换成你们 NZ 库的真实表名和字段）：
/*
SELECT
    p.Code          AS ProductCode,
    p.Name          AS ProductName,
    p.Family        AS ProductFamily,
    w.Name          AS DisplayWarehouse
FROM dbo.ProductDisplay pd
JOIN dbo.Product p ON p.Id = pd.ProductId
JOIN dbo.Warehouse w ON w.Id = pd.WarehouseId
WHERE pd.IsDisplayed = 1
  AND w.IsActive = 1;
*/

-- 下面这行只是占位，不要直接执行；请删掉并写上真实 SELECT
SELECT '请复制 display.sql.example 为 display.sql 并填写真实查询' AS hint;
